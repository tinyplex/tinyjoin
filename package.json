{
  "name": "tinygres",
  "version": "0.0.0",
  "author": "jamesgpearce",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:lib": "node scripts/build-lib.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "cargo": "node scripts/cargo.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:size",
    "check:release": "npm run check && npm run test:browser && npm run test:package",
    "check:size": "node scripts/check-size.mjs",
    "prePublishPackage": "npm run check:release",
    "publishPackage": "npm run prePublishPackage && npm publish ./dist",
    "test": "npm run test:rust && npm run test:ts",
    "test:browser": "npm run build && npm run typecheck:browser && playwright test",
    "test:browser:serve": "vite test/browser/app",
    "test:package": "node scripts/test-packed-consumer.mjs",
    "test:rust": "node scripts/cargo.mjs test --workspace",
    "test:ts": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:browser": "tsc --noEmit -p test/browser/app/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyplex/tinygres.git"
  },
  "license": "MIT",
  "description": "A tiny, worker-first local query cache for PostgreSQL data.",
  "keywords": [
    "postgresql",
    "client",
    "browser",
    "tiny",
    "local-first"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wasm-pack": "^0.15.0"
  }
}
