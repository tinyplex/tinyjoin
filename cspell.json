  "ignoreWords": [],
  "import": [],
  "overrides": [
    {
      "filename": "**/*.rs",
      "ignoreRegExpList": [
        "/\\b0x[0-9a-f_]+(?:[ui](?:8|16|32|64|128|size))?\\b/gi"
      ]
    },
    {
      "filename": "crates/tinyjoin-core/src/btree.rs",
      "words": [
        "TGBT",
        "TGOV"
      ]
    },
    {
      "filename": "crates/tinyjoin-core/src/page.rs",
      "words": [
        "TGRPAGE",
        "TGRSUPR"
      ]
    },
    {
      "filename": "crates/tinyjoin-core/src/checksum.rs",
      "words": [
        "spammish",
        "xxhsum"
      ]
    },
    {
      "filename": "crates/tinyjoin-core/src/join.rs",
      "ignoreRegExpList": [
        "/'Rnull2'/g"
      ]
    },
    {
      "filename": "crates/tinyjoin-core/src/paged_codec.rs",
      "ignoreRegExpList": [
        "/\"insideÿpayload\"/g"
      ]
    },
    {
      "filename": "site/ui/Page.tsx",
      "ignoreRegExpList": [
        "/\\bG-[A-Z0-9]+\\b/g"
      ]
    }
  ]
}
