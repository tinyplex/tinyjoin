{
  "name": "tinyjoin",
  "version": "0.0.6",
  "author": "jamesgpearce",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "types": "./dist/@types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/@types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/@types/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/@types/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./vite": {
      "types": "./dist/@types/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:docs": "npm run build && npm run build:docs:built",
    "build:docs:built": "node scripts/build-docs.mjs",
    "build:lib": "node scripts/build-lib.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "cargo": "node scripts/cargo.mjs",
    "check": "npm run check:source && npm run build && npm run test:wasm:built && npm run check:size",
    "check:docs": "npm run build:docs && npm run check:docs:built",
    "check:docs:built": "node scripts/check-docs.mjs",
    "check:docs:committed": "node scripts/check-docs-fresh.mjs",
    "check:demo-runtime": "node scripts/check-demo-runtime.mjs",
    "check:release": "npm run spell && npm run setup:rust:advisories && npm run check:rust:advisories && npm run check:docs:committed && npm run check:source && npm run build && npm run build:docs:built && npm run check:docs:built && npm run check:demo-runtime && npm run test:docs:built && npm run test:wasm:contract && npm run check:size && npm run test:browser:built && npm run test:package:built && npm run test:offline:built",
    "check:source": "npm run typecheck && npm test",
    "check:size": "node scripts/check-size.mjs",
    "prePublishPackage": "npm ci && npm run check:release",
    "publishPackage": "npm run prePublishPackage && npm publish ./dist",
    "serve:docs": "vite docs",
    "spell": "cspell --no-progress --dot",
    "test": "npm run test:rust && npm run test:ts",
    "test:browser": "npm run build && npm run test:browser:built",
    "test:browser:built": "npm run typecheck:browser && playwright test",
    "test:browser:serve": "vite test/browser/app",
    "test:docs:built": "playwright test --config playwright.docs.config.ts",
    "test:docs:serve": "vite preview --outDir docs",
    "test:offline:built": "node scripts/test-offline.mjs",
    "test:package": "node scripts/test-packed-consumer.mjs",
    "test:package:built": "node scripts/test-packed-consumer.mjs --built",
    "test:rust": "node scripts/cargo.mjs test --workspace --locked",
    "test:ts": "vitest run --exclude test/worker/wasm-bridge-cross.test.ts",
    "test:wasm": "npm run build:wasm && npm run test:wasm:built",
    "test:wasm:built": "npm run test:wasm:contract && playwright test test/browser/paged-memory.spec.ts",
    "test:wasm:contract": "vitest run test/worker/wasm-bridge-cross.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site/tsconfig.json",
    "typecheck:browser": "tsc --noEmit -p test/browser/app/tsconfig.json",
    "check:rust:advisories": "node scripts/check-rust-advisories.mjs",
    "setup:rust:advisories": "cargo install cargo-audit --version 0.22.2 --locked --root .cache/tinyjoin/audit-tools"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyplex/tinyjoin.git"
  },
  "homepage": "https://tinyjoin.org",
  "bugs": {
    "url": "https://github.com/tinyplex/tinyjoin/issues"
  },
  "license": "MIT",
  "description": "A tiny, worker-first relational database for browser apps.",
  "keywords": [
    "postgresql",
    "database",
    "browser",
    "tiny",
    "opfs",
    "webassembly"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "cspell": "^10.3.1",
    "esbuild": "^0.28.2",
    "less": "^4.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "terser": "^5.51.2",
    "tinydocs": "^0.1.76",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wasm-pack": "^0.15.0"
  }
}
